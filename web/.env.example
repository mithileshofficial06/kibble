# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   aevum = QDay Aevum testnet (chain 44005): the Kibble demo deployment is built in
#   fork  = `make fork`: local copy of Aevum on 127.0.0.1:8555 (chain 440050), after `setup-demo`
#   local = `make anvil`: empty local chain on 127.0.0.1:8545 (chain 31337), after `setup-demo`
NEXT_PUBLIC_NETWORKS=aevum

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Where the "View the code" links point. Default: https://github.com/mithileshofficial06/kibble
NEXT_PUBLIC_REPO_URL=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----

# Public playground: three no-wallet buttons that run short demos with the demo keys.
# Off unless set to "on". Run the app with `next start` (a long-running server): run state lives in memory.
KIBBLE_PLAYGROUND=
# The network the playground runs on. Default: Aevum testnet.
PLAYGROUND_RPC_URL=https://rpc-test.qday.info
# The demo keys: a .env file with OWNER_/GUARDIAN_/AGENT_A_/AGENT_B_/SUPPLIER_/BUYER_/RELAYER_PRIVATE_KEY,
# or set those seven variables here. TEST wallets only, never ones that hold anything of value.
KIBBLE_WALLETS=
# Limits. Defaults: 60 s between runs, 3 runs per IP per day, 20 runs per day.
# PLAYGROUND_COOLDOWN_S=60
# PLAYGROUND_PER_IP_PER_DAY=3
# PLAYGROUND_RUNS_PER_DAY=20
# The header your host sets with the real client IP. Unset: last X-Forwarded-For entry.
# TRUSTED_IP_HEADER=
